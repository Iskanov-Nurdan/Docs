# ---------- Собирается при развёртывании ----------
# Конфиг nginx под конкретный домен: его пишет scripts/deploy.sh из
# nginx/prod.conf. В репозитории лежит образец, а не результат.
nginx/active.conf

# Собранный фронтенд: его строят командой scripts/build-web.sh и увозят на
# сервер. В репозитории лежат исходники, а не результат сборки.
/web/
