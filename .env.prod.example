# Настройки боевого сервера. Скопируйте в .env и заполните.
#
#     cp .env.prod.example .env
#     nano .env
#     ./scripts/deploy.sh
#
# Файл .env в репозиторий не попадает и не должен: в нём пароли.

# --- Домен ---
# Имя, по которому открывается приложение. A-запись этого имени должна
# указывать на адрес сервера ещё до запуска: по ней Let's Encrypt проверяет,
# что домен ваш.
DOMAIN=app.alitrade.tw1.ru
# Сюда придёт письмо, если сертификат перестанет продлеваться. Адрес живой,
# проверяемый: другого предупреждения не будет.
LETSENCRYPT_EMAIL=admin@alitrade.tw1.ru

# --- Django ---
# Сгенерировать: openssl rand -base64 48
# Ключом подписаны токены входа. Смена ключа выбрасывает всех из системы.
DJANGO_SECRET_KEY=ЗАМЕНИТЕ-на-случайную-строку-не-короче-40-символов
# В бою только False: с True наружу уходит текст ошибки вместе с настройками.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.alitrade.tw1.ru
DJANGO_TIME_ZONE=Asia/Bishkek
LOG_LEVEL=INFO

# --- База данных ---
POSTGRES_DB=docs
POSTGRES_USER=docs
# Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=ЗАМЕНИТЕ-на-длинный-пароль
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Сроки жизни токенов ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# --- Адреса, которым разрешено обращаться к API ---
# Приложение и API живут на одном имени, поэтому здесь только оно.
CORS_ALLOWED_ORIGINS=https://app.alitrade.tw1.ru
CSRF_TRUSTED_ORIGINS=https://app.alitrade.tw1.ru

# --- Хранилище файлов ---
# Пусто — выгрузки и картинки лежат на диске сервера, в томе media_files.
# Заполнять есть смысл, когда файлов станет больше, чем места на диске.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=docs
S3_REGION=ru-1

# --- Почта ---
# Без настоящего SMTP не работают подтверждение адреса и сброс пароля:
# письма уходят в журнал контейнера, человек их не получит.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.timeweb.ru
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@alitrade.tw1.ru
EMAIL_HOST_PASSWORD=ЗАМЕНИТЕ-на-пароль-почтового-ящика
DEFAULT_FROM_EMAIL=noreply@alitrade.tw1.ru

# --- Ограничения ---
MAX_UPLOAD_MB=25
MAX_DOCUMENT_MB=64

# Сколько наших прокси стоит перед приложением. У нас это один nginx.
# Ошибиться здесь — значит отключить защиту от подбора пароля: заголовок
# с адресом клиента подставляет он сам, и лишнее звено даёт ему чужой счётчик.
NUM_PROXIES=1

# --- Фронтенд ---
# Где на сервере лежит собранная статика. По умолчанию — папка web/ рядом
# с docker-compose.prod.yml. Меняйте, если привыкли класть фронт отдельно:
#   WEB_DIR=/opt/alitrade/frontend
WEB_DIR=./web

# --- Адреса для сборки фронтенда (подставляются на своей машине) ---
# Пустые значения означают «тот же адрес, что и страница» — и это верно:
# всё приложение отдаётся с одного домена.
VITE_API_URL=/api
VITE_WS_URL=
