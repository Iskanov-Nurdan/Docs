# Скрипты и конфигурация сервера всегда с переводом строки Unix.
# Иначе git на Windows положит в них CR, и на Linux скрипт не запустится:
# ядро ищет интерпретатор «/usr/bin/env bash\r» и не находит.
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
.env.prod.example text eol=lf
